<?xml version="1.0" encoding="utf-8"?>
<!-- jarvis: 弹窗入场（源自 VodPlus 的 m3_motion_fade_enter，时长/曲线按原值写死） -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@interpolator/m3_sys_motion_easing_emphasized_decelerate"
    android:duration="400">
    <alpha android:fromAlpha="0.0" android:toAlpha="1.0" />
    <scale
        android:fromXScale="0.8" android:toXScale="1.0"
        android:fromYScale="0.8" android:toYScale="1.0"
        android:pivotX="50%" android:pivotY="50%" />
</set>
